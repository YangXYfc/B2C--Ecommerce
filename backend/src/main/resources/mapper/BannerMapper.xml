<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.team.ecommerce.admin.mapper.BannerMapper">

    <resultMap id="bannerMap" type="com.team.ecommerce.admin.entity.BannerEntity">
        <constructor>
            <idArg column="id" javaType="Long"/>
            <arg column="title" javaType="String"/>
            <arg column="image_url" javaType="String"/>
            <arg column="link_url" javaType="String"/>
            <arg column="sort" javaType="Integer"/>
            <arg column="status" javaType="Integer"/>
            <arg column="created_at" javaType="java.time.LocalDateTime"/>
            <arg column="updated_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <select id="selectById" resultMap="bannerMap">
        SELECT * FROM banner WHERE id = #{id}
    </select>

    <select id="selectEnabled" resultMap="bannerMap">
        SELECT * FROM banner WHERE status = 1 ORDER BY sort ASC
    </select>

    <select id="selectAll" resultMap="bannerMap">
        SELECT * FROM banner ORDER BY sort ASC
    </select>

    <select id="lastInsertId" resultType="long">
        SELECT LAST_INSERT_ID()
    </select>

    <insert id="insert">
        INSERT INTO banner (title, image_url, link_url, sort, status)
        VALUES (#{title}, #{imageUrl}, #{linkUrl}, #{sort}, #{status})
    </insert>

    <update id="updateById">
        UPDATE banner
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="imageUrl != null">image_url = #{imageUrl},</if>
            <if test="linkUrl != null">link_url = #{linkUrl},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            updated_at = CURRENT_TIMESTAMP
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM banner WHERE id = #{id}
    </delete>

</mapper>
