<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.team.ecommerce.trade.payment.mapper.PaymentMapper">

    <resultMap id="paymentMap" type="com.team.ecommerce.trade.payment.entity.PaymentEntity">
        <constructor>
            <idArg column="id" javaType="Long"/>
            <arg column="payment_no" javaType="String"/>
            <arg column="order_id" javaType="Long"/>
            <arg column="user_id" javaType="Long"/>
            <arg column="amount" javaType="java.math.BigDecimal"/>
            <arg column="pay_method" javaType="String"/>
            <arg column="status" javaType="Integer"/>
            <arg column="pay_time" javaType="java.time.LocalDateTime"/>
            <arg column="created_at" javaType="java.time.LocalDateTime"/>
            <arg column="updated_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <select id="selectById" resultMap="paymentMap">
        SELECT * FROM payment WHERE id = #{id}
    </select>

    <select id="selectByOrderId" resultMap="paymentMap">
        SELECT * FROM payment WHERE order_id = #{orderId}
    </select>

    <select id="lastInsertId" resultType="long">
        SELECT LAST_INSERT_ID()
    </select>

    <insert id="insert">
        INSERT INTO payment (payment_no, order_id, user_id, amount, pay_method, status, pay_time)
        VALUES (#{paymentNo}, #{orderId}, #{userId}, #{amount}, #{payMethod}, #{status}, #{payTime})
    </insert>

    <update id="updateById">
        UPDATE payment
        <set>
            <if test="paymentNo != null">payment_no = #{paymentNo},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="payMethod != null">pay_method = #{payMethod},</if>
            <if test="status != null">status = #{status},</if>
            <if test="payTime != null">pay_time = #{payTime},</if>
            updated_at = CURRENT_TIMESTAMP
        </set>
        WHERE id = #{id}
    </update>

</mapper>
